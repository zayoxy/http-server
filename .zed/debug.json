[
  // https://zed.dev/docs/languages/c#debugging
  {
    "label": "Compile and Debug C http_server",
    "build": {
      "command": "cmake",
      "args": ["--build", "$ZED_WORKTREE_ROOT/build"],
      "cwd": "$ZED_WORKTREE_ROOT",
    },
    "program": "$ZED_WORKTREE_ROOT/build/http_server",
    "request": "launch",
    "adapter": "GDB",
  },
]
